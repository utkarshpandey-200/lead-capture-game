# Copy to .env and fill in real values before deploying.

# --- Server / infra ---
PORT=8080
NODE_ENV=development
DATABASE_PATH=./data/quiz.sqlite
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MS=259200000
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_MS=43200000
# Only set this if the client is ever served from a different origin than the API (not the typical deployment).
CORS_ORIGIN=
TRUST_PROXY=true

# --- Quiz flags ---
# Seed questions ship as status "draft". Set true for local dev/testing so
# the quiz has questions to serve; set false (default) in production until
# you've fact-checked and approved questions in /admin.
ALLOW_DRAFT_QUESTIONS=false

# --- Quiz mechanics ---
# Questions per attempt = QUIZ_KNOWLEDGE_COUNT + QUIZ_SCENARIO_COUNT (no separate total to keep in sync).
QUIZ_KNOWLEDGE_COUNT=3
QUIZ_SCENARIO_COUNT=0
QUESTION_TIME_LIMIT_MS=20000
MAX_ATTEMPTS=2
KIOSK_IDLE_TIMEOUT_MS=45000
CLIENT_TIMING_TOLERANCE_MS=3000

# --- Rate limits (requests per 1-minute window) ---
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_REGISTER_MAX=8
RATE_LIMIT_ANSWER_MAX=60
RATE_LIMIT_ADMIN_LOGIN_MAX=10

# --- Display screen ---
DISPLAY_POLL_INTERVAL_MS=3000
DISPLAY_TOP_N=5

# --- Event ---
EVENT_TIMEZONE=America/Los_Angeles

# --- Branding (pulled from precisioncuso.org's live site: navy/blue/gold, DM Sans) ---
BRAND_NAME=Precision CUSO
BRAND_LOGO_PATH=/brand/precision-cuso-logo.webp
BRAND_PRIMARY_COLOR=#072559
BRAND_SECONDARY_COLOR=#F5B731
BRAND_ACCENT_COLOR=#0F8B4C

# --- Copy ---
QUIZ_TITLE=Credit Union Quiz
INTRO_HEADLINE=How fast and how well do you know about the Credit Union movement?
INTRO_BODY=Answer 3 quick questions about Credit Union movement. You're scored on accuracy and speed.
CONSENT_TEXT=I agree to be contacted by Precision CUSO about this quiz and related information.
CONSENT_VERSION=2026-10-v1

# --- Links (REPLACE before the event) ---
PRIVACY_POLICY_URL=https://www.precisioncuso.com/privacy
BOOKING_URL=https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1on6Qya4-DTxrA7fu64uLFM6JEUeHQ_pY2rIsXUXdMUJtapL5e5wP6VJaw9L2qCSN9MtRzwTlV
PLAY_BASE_URL=https://quiz.precisioncuso.com
